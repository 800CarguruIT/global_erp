LOAD DATABASE
  FROM mysql://root:root123@host.docker.internal:3310/carguru2
  INTO postgresql://autoguru:autoguru@host.docker.internal:5432/global_erp_migration

 WITH include no drop, create no tables, truncate, data only

 CAST
   type date to date using zero-dates-to-null,
   type datetime to timestamptz using zero-dates-to-null,
   type timestamp to timestamptz using zero-dates-to-null;

