# ═══════════════════════════════════════════════
#  Global ERP — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/global_erp

# ── Authentication ────────────────────────────
# Secret for signing session tokens (min 32 chars, random)
AUTH_SECRET=generate-a-random-secret-min-32-chars-here

# ── Application URLs ──────────────────────────
# Primary application URL (used for internal API calls)
APP_BASE_URL=http://localhost:3000
# Public-facing URL (used in emails, links, webhooks)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── AI / OpenAI ───────────────────────────────
# OpenAI API key (optional — AI features degrade gracefully without it)
OPENAI_API_KEY=sk-...
# AI model overrides (optional — defaults shown)
# CALL_AI_MODEL=gpt-4.1-mini
# CALL_AI_TRANSCRIBE_MODEL=whisper-1
# CALL_AI_ANALYSIS_MODEL=gpt-4.1-mini
# PRE_INSPECTION_ASSIST_MODEL=gpt-4.1-mini
# AI master kill switch (set to false/0/off to disable all AI globally)
# AI_MASTER_ENABLED=true

# ── Integration Auth ─────────────────────────
# Secret for signing integration/vendor portal JWTs
INTEGRATION_AUTH_SECRET=generate-another-random-secret-here
# INTEGRATION_JWT_ISSUER=global-erp
# INTEGRATION_JWT_AUDIENCE=global-erp-integrations
# INTEGRATION_ACCESS_TTL_SECONDS=3600

# ── Dialer (Yeastar PBX) ─────────────────────
# YEASTAR_CONTACT_COMPANY_ID=
# YEASTAR_CONTACT_QUERY_TOKEN=
# NEXT_PUBLIC_LINKUS_SDK_URL=
# DIALER_WEBHOOK_LOG_PATH=./tmp/webhook-dialer.log

# ── Node ──────────────────────────────────────
NODE_ENV=development
PORT=3000
